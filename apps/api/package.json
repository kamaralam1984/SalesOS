{
  "name": "@salesos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch --watch-path=dist dist/main.js)",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test scripts perf",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx --env-file-if-exists=../../.env src/owner-bootstrap/bootstrap.ts",
    "db:seed:starter": "tsx --env-file-if-exists=../../.env src/owner-bootstrap/starter-programs.ts",
    "db:seed:demo": "tsx --env-file-if-exists=../../.env src/seed/seed.ts",
    "permissions:matrix": "tsx scripts/gen-permissions-matrix.ts",
    "db:guards:export": "tsx scripts/export-guards.ts",
    "db:migration:build": "tsx scripts/build-migration.ts",
    "migration-check": "tsx scripts/migration-check.ts",
    "perf:analytics": "vitest run --config vitest.perf.config.ts",
    "docs:kpi": "UPDATE_KPI_DOC=1 vitest run test/analytics/dictionary-doc.spec.ts",
    "test:proc": "rm -rf dist-l2 && tsc -p tsconfig.build.json --outDir dist-l2 && vitest run --config vitest.proc.config.ts; rc=$?; rm -rf dist-l2; exit $rc"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "@salesos/crm-core": "workspace:*",
    "@salesos/cx-core": "workspace:*",
    "@salesos/workforce-core": "workspace:*",
    "@salesos/platform-core": "workspace:*",
    "@salesos/shared-types": "workspace:*",
    "@salesos/validation": "workspace:*",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "sharp": "0.35.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
