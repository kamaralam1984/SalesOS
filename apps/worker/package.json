{
  "name": "@salesos/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:proc": "rm -rf dist-l2 && tsc -p tsconfig.build.json --outDir dist-l2 && vitest run --config vitest.proc.config.ts; rc=$?; rm -rf dist-l2; exit $rc"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@salesos/crm-core": "workspace:*",
    "@salesos/cx-core": "workspace:*",
    "@salesos/workforce-core": "workspace:*",
    "@salesos/platform-core": "workspace:*",
    "@salesos/shared-types": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
