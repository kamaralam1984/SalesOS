# Public (shipped to the browser) - never put secrets here.
# Use the same host family as the API cookie (localhost <-> localhost) so SameSite=Lax cookies are sent.
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
# Name of the API's HttpOnly session cookie (used by the route guard for coarse redirects only).
SESSION_COOKIE_NAME=salesos_session
# Server-only: origin(s) allowed in CSP connect-src, derived from NEXT_PUBLIC_API_URL by default.
