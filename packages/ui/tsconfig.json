{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"]
}
