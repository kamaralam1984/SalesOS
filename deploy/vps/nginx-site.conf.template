# SalesOS site for __DOMAIN__ (ONE new file; never edit other sites' files). Validate with `nginx -t`, then `nginx -s reload` (never restart).
# Install: /etc/nginx/sites-available/__DOMAIN__ + symlink in sites-enabled. nginx 1.18: `listen 443 ssl http2` (not the `http2 on;` directive).
upstream salesos_web { server 127.0.0.1:3100; keepalive 16; }
upstream salesos_api { server 127.0.0.1:4100; keepalive 32; }

limit_req_zone $binary_remote_addr zone=salesos_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=salesos_login:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=salesos_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    location /.well-known/acme-challenge/ { root /var/www/salesos-acme; }
    location / { return 301 https://$host$request_uri; }
}
