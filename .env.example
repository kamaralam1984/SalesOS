# CoachEasily SalesOS - copy to .env. Placeholders only; never commit real secrets.
NODE_ENV=development

# --- API (apps/api) ---
PORT=4100
LOG_LEVEL=info
# Local docker-compose Postgres (salesos-postgres on 5533). Use your own DB name per developer/agent.
DATABASE_URL="postgresql://salesos:salesos_dev_only@127.0.0.1:5533/salesos?schema=public"
# Local docker-compose Redis (salesos-redis on 6391)
REDIS_URL="redis://127.0.0.1:6391"
BULLMQ_PREFIX=salesos

# Explicit origins only. Wildcards are rejected (cookies are credentialed).
CORS_ORIGINS="http://localhost:3100"
APP_BASE_URL="http://localhost:3100"
TRUST_PROXY=false
ENABLE_DOCS=true

# --- Sessions / CSRF (generate: openssl rand -base64 48) ---
SESSION_SECRET="change-me-generate-with-openssl-rand-base64-48"
SESSION_COOKIE_NAME=salesos_session
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
SESSION_ROTATE_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RESET_TOKEN_TTL_MINUTES=60
INVITE_TOKEN_TTL_HOURS=72

# --- Rate limiting ---
THROTTLE_STORAGE=redis
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_LOGIN_LIMIT=10

# --- Worker (apps/worker) ---
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_DISPATCH_ATTEMPTS=8
EVENT_JOB_ATTEMPTS=5
EVENT_JOB_BACKOFF_MS=2000
EVENT_CONCURRENCY=5

# --- Object storage (MinIO from docker-compose; used by the files module later) ---
S3_ENDPOINT="http://127.0.0.1:9100"
S3_REGION=us-east-1
S3_BUCKET=salesos-private
S3_ACCESS_KEY=salesos_minio
S3_SECRET_KEY=salesos_minio_dev_only

# --- Web (apps/web) ---
# Read at BUILD time by the browser bundle and the proxy; must be reachable from the browser.
NEXT_PUBLIC_API_URL="http://localhost:4100/api/v1"
# 404s the dev style guide in production unless true (CI a11y runs only)
# ENABLE_STYLE_GUIDE=false
# Build output directory override (parallel builds); relative to apps/web
# NEXT_DIST_DIR=

# --- Platform (notifications, files, integrations, AI) ---
# 32 bytes, base64 or 64 hex chars. REQUIRED in production (encrypts integration secrets, AES-256-GCM). Dev/test derive a key from SESSION_SECRET.
# PLATFORM_ENCRYPTION_KEY=
# Object storage settings are in the section above (private bucket, created on boot; use a distinct bucket per environment).
# S3_PUBLIC_ENDPOINT=   # host used in signed URLs if the browser reaches storage differently
# File scanning: local (EICAR only, NOT an antivirus) | clamd | none
FILE_SCANNER=local
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# AI Copilot is OFF by default (enable in Admin > AI Copilot). Provider keys live ONLY in the server environment:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Worker tuning
# DELIVERY_BACKOFF_BASE_MS=30000
# DELIVERY_TICK_MS=5000
# NOTIFICATION_STREAM_POLL_MS=2000
# Tolerance (seconds) for the signed timestamp of inbound provider webhooks
# WEBHOOK_TOLERANCE_SECONDS=300
# CRM events are notified by the CRM worker through the platform port; keep false to avoid duplicate alerts.
PLATFORM_AUTO_NOTIFY_CRM_EVENTS=false

# --- Revenue target-risk nudge (default rule awaiting owner approval, INT-11) ---
# TARGET_RISK_PACE_PCT=70
# TARGET_RISK_MIN_ELAPSED_PCT=25

# --- CRM live updates ---
# CRM_STREAM_POLL_MS=3000
# CRM_STREAM_MAX_MS=600000

# --- Analytics / KPI / exports ---
# KPI cache TTL in seconds (0 disables caching). Redis key prefix MUST match between api and worker.
# KPI_CACHE_TTL_SECONDS=30
# ANALYTICS_CACHE_PREFIX=salesos:kpi
# Exclude [DEMO] data from KPIs (default true in production, false otherwise)
# KPI_EXCLUDE_DEMO=
# Worker: periodic KPI snapshots
# ANALYTICS_SCHEDULER=true
# ANALYTICS_SCHEDULER_INTERVAL_MS=300000
# Report exports (row caps, retention, runner)
# EXPORT_MAX_ROWS_CSV=100000
# EXPORT_MAX_ROWS_XLSX=50000
# EXPORT_SYNC_ROWS=1000
# EXPORT_RETENTION_HOURS=72
# EXPORT_RUNNER=true
# EXPORT_RUNNER_INTERVAL_MS=5000
# Audit-log CSV export row cap (hard limit 10000)
# AUDIT_EXPORT_MAX_ROWS=10000
# WORKFORCE_EXPORT_MAX_ROWS=10000

# --- Migrations / tests (not needed in production) ---
# Apply the committed migrations:  pnpm db:migrate     (prisma migrate deploy; safe to re-run)
# Prove them on an empty throwaway database:  pnpm migration-check
# Test databases (NEVER the shared "salesos" database). TEST_DB_MODE=migrate builds them ONLY from the migrations.
# TEST_DATABASE_URL="postgresql://salesos:salesos_dev_only@127.0.0.1:5533/salesos_test?schema=public"
# TEST_WORKER_DATABASE_URL="postgresql://salesos:salesos_dev_only@127.0.0.1:5533/salesos_wtest?schema=public"
# TEST_DB_MODE=migrate
# Playwright (apps/web): E2E_WEB_PORT, E2E_API_PORT, E2E_BASE_URL, E2E_DB (database the API under test uses; used for time travel in journeys)
# E2E_WEB_PORT=3100
# E2E_API_PORT=4100

# --- Phase 10 security (see docs/security-review.md) ---
# Production refuses to start without: strong SESSION_SECRET, PLATFORM_ENCRYPTION_KEY, THROTTLE_STORAGE=redis, https CORS_ORIGINS/APP_BASE_URL,
# S3_ENDPOINT/S3_BUCKET/S3_ACCESS_KEY/S3_SECRET_KEY (no dev fallbacks), ENABLE_DOCS unset/false, and a non-default DATABASE_URL password.
# Use the least-privilege app role (prisma/sql/db-roles.sql) for the API/worker; run `prisma migrate deploy` with the migration role.
# DB_AUTO_DDL=false   # default false in production (guards are verified, not created); true in dev/test
# Route-specific rate limits (requests per IP per THROTTLE_HEAVY_TTL_MS=60000):
# THROTTLE_UPLOAD_LIMIT=60  THROTTLE_IMPORT_LIMIT=10  THROTTLE_EXPORT_LIMIT=20  THROTTLE_AI_LIMIT=30  THROTTLE_REPORT_LIMIT=20  THROTTLE_DOWNLOAD_LIMIT=120  THROTTLE_ADMIN_ACTION_LIMIT=30
# FORGOT_PASSWORD_MIN_MS=400

# --- Phase 10 operations / observability ---
# Graceful shutdown watchdog for the API (ms): exit 1 if draining takes longer
# SHUTDOWN_GRACE_MS=25000
# Prometheus scrape token for GET /metrics (>=16 chars). Unset in production => /metrics returns 404. Never route /metrics publicly.
# METRICS_TOKEN=
# Optional Sentry-compatible error reporting (API + worker). No DSN is ever committed.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# Worker: BullMQ lock duration, Redis heartbeat interval, optional HTTP health port (0 = off), shutdown grace
# WORKER_LOCK_DURATION_MS=30000
# WORKER_HEARTBEAT_MS=10000
# WORKER_HEALTH_PORT=0
# WORKER_SHUTDOWN_GRACE_MS=25000

# Bootstrap (pnpm db:seed): creates org + owner Founder only. Set real values in your own env, never commit them.
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_NAME="Owner Name"
# BOOTSTRAP_ADMIN_PASSWORD=change-me-min-10-chars
# BOOTSTRAP_ORG_NAME=CoachEasily
# BOOTSTRAP_ORG_SLUG=coacheasily   (also used by `pnpm db:seed:starter`, the JD program catalogue: no prices, leads or people)

# Optional: max concurrent live-update (SSE) streams per user (default in code)
# CRM_STREAM_MAX_PER_USER=5
# Optional: release identifier reported to the error tracker
# RELEASE=

# DEV ONLY sample-data loader (apps/api/src/seed/sample-month). Refuses production and non-local databases.
# LOAD_DEMO_ORG_SLUG=coacheasily
# SAMPLE_SEED=
# SAMPLE_CRED_OUT=/path/to/creds.json
# SAMPLE_STAGES=1,3,4
