model User {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  email             String             @unique
  name              String
  passwordHash      String?            @map("password_hash")
  isActive          Boolean            @default(true) @map("is_active")
  managerId         String?            @map("manager_id") @db.Uuid
  /// Free-text department label (JD header: Department Sales). Does not affect permissions.
  department        String?
  failedLoginCount  Int                @default(0) @map("failed_login_count")
  lockedUntil       DateTime?          @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?          @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?          @map("password_changed_at") @db.Timestamptz(6)
  deactivatedAt     DateTime?          @map("deactivated_at") @db.Timestamptz(6)
  /// Existing accounts are APPROVED; new ones start PENDING (login and invite stay blocked until approved by someone other than the creator).
  approvalStatus    UserApprovalStatus @default(APPROVED) @map("approval_status")
  createdById       String?            @map("created_by_id") @db.Uuid
  approvedById      String?            @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?          @map("approved_at") @db.Timestamptz(6)
  approvalNote      String?            @map("approval_note")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manager              User?                  @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports              User[]                 @relation("ManagerReports")
  createdBy            User?                  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers         User[]                 @relation("UserCreatedBy")
  approvedBy           User?                  @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers        User[]                 @relation("UserApprovedBy")
  resetRequests        PasswordResetRequest[] @relation("ResetRequestUser")
  resetRequestsHandled PasswordResetRequest[] @relation("ResetRequestHandler")
  meetingsCreated      CompanyMeeting[]       @relation("CompanyMeeting_createdById")
  meetingsCancelled    CompanyMeeting[]       @relation("CompanyMeeting_cancelledById")
  meetingJoins         CompanyMeetingJoin[]   @relation("CompanyMeetingJoin_userId")

  roleAssignments   UserRoleAssignment[] @relation("AssignmentUser")
  assignedRoles     UserRoleAssignment[] @relation("AssignmentBy")
  teamMemberships   TeamMembership[]
  ledTeams          Team[]               @relation("TeamLead")
  delegationsGiven  Delegation[]         @relation("DelegationDelegator")
  delegationsGotten Delegation[]         @relation("DelegationDelegate")
  delegationsMade   Delegation[]         @relation("DelegationCreator")
  sessions          Session[]
  tokens            AuthToken[]

  // back-relations from the domain schemas (FK integrity; generated by the integration pass)
  automationRuleUpdatedBy              AutomationRule[]                 @relation("AutomationRule_updatedById")
  assignmentRuleLastAssignedUser       AssignmentRule[]                 @relation("AssignmentRule_lastAssignedUserId")
