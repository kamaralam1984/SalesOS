// Identity domain (Phase 1/2): organizations, users, RBAC, teams, sessions, audit, outbox, idempotency.

enum MembershipRole {
  LEAD
  MEMBER
}

/// A new account stays PENDING (no login, no invite link) until someone other than its creator approves it.
enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResetRequestStatus {
  PENDING
  ISSUED
  DISMISSED
}

enum TokenPurpose {
  PASSWORD_RESET
  INVITE
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  DEAD
}

