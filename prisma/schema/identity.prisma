  handoverRecordOwner                  HandoverRecord[]                 @relation("HandoverRecord_ownerId")
  handoverRecordCreatedBy              HandoverRecord[]                 @relation("HandoverRecord_createdById")
  handoverRecordReceivingOwner         HandoverRecord[]                 @relation("HandoverRecord_receivingOwnerId")
  xfTaskOwner                          XfTask[]                         @relation("XfTask_ownerId")
  xfTaskRequester                      XfTask[]                         @relation("XfTask_requesterId")
  xfTaskConfirmedBy                    XfTask[]                         @relation("XfTask_confirmedById")
  xfTaskCommentAuthor                  XfTaskComment[]                  @relation("XfTaskComment_authorId")
  campaignPlanLinkOwner                CampaignPlanLink[]               @relation("CampaignPlanLink_ownerId")
  campaignPlanLinkCreatedBy            CampaignPlanLink[]               @relation("CampaignPlanLink_createdById")
  insightAuthor                        Insight[]                        @relation("Insight_authorId")
  founderReportAuthor                  FounderReport[]                  @relation("FounderReport_authorId")
  founderReportPublishedBy             FounderReport[]                  @relation("FounderReport_publishedById")
  founderReportReviewedBy              FounderReport[]                  @relation("FounderReport_reviewedById")
  founderReportSnapshotPublishedBy     FounderReportSnapshot[]          @relation("FounderReportSnapshot_publishedById")
  riskEntryOwner                       RiskEntry[]                      @relation("RiskEntry_ownerId")
  riskEntryRaisedBy                    RiskEntry[]                      @relation("RiskEntry_raisedById")
  actionItemOwner                      ActionItem[]                     @relation("ActionItem_ownerId")
  actionItemCreatedBy                  ActionItem[]                     @relation("ActionItem_createdById")
  notificationUser                     Notification[]                   @relation("Notification_userId")
  notificationPreferenceUser           NotificationPreference[]         @relation("NotificationPreference_userId")
  notificationUserSettingsUser         NotificationUserSettings[]       @relation("NotificationUserSettings_userId")
  notificationDeliveryUser             NotificationDelivery[]           @relation("NotificationDelivery_userId")
  consentRecordRecordedBy              ConsentRecord[]                  @relation("ConsentRecord_recordedById")
  providerCallEventUser                ProviderCallEvent[]              @relation("ProviderCallEvent_userId")
  fileAssetUploader                    FileAsset[]                      @relation("FileAsset_uploaderId")
  fileAssetDeletedBy                   FileAsset[]                      @relation("FileAsset_deletedById")
  fileAttachmentAttachedBy             FileAttachment[]                 @relation("FileAttachment_attachedById")
  aiSuggestionUser                     AiSuggestion[]                   @relation("AiSuggestion_userId")
  aiUsageLogUser                       AiUsageLog[]                     @relation("AiUsageLog_userId")
  deviceUser                           Device[]                         @relation("Device_userId")
  deviceApprovedBy                     Device[]                         @relation("Device_approvedById")
  deviceRevokedBy                      Device[]                         @relation("Device_revokedById")
  platformSettingUpdatedBy             PlatformSetting[]                @relation("PlatformSetting_updatedById")

  // back-relations from the domain schemas (FK integrity; generated by the integration pass)
  reportExportRequestedBy ReportExport[] @relation("ReportExport_requestedById")
  savedFilterUser         SavedFilter[]  @relation("SavedFilter_userId")

  @@index([organizationId, managerId])
  @@index([organizationId, isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  domain      String
  description String
  sensitive   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

/// Mirror of the code catalogue (permissions.catalogue.ts); synced on bootstrap/seed.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  /// own | team | org
  scope        String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  assignedById   String?  @map("assigned_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?        @relation("AssignmentBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([organizationId, roleId])
  @@map("user_role_assignments")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  leadUserId     String?  @map("lead_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead         User?            @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  memberships  TeamMembership[]

  // back-relations from the domain schemas (FK integrity; generated by the integration pass)
  automationRuleTeam         AutomationRule[]         @relation("AutomationRule_teamId")
  assignmentRuleTeam         AssignmentRule[]         @relation("AssignmentRule_teamId")
  leadTeam                   Lead[]                   @relation("Lead_teamId")
  taskTeam                   Task[]                   @relation("Task_teamId")
  reassignmentQueueEntryTeam ReassignmentQueueEntry[] @relation("ReassignmentQueueEntry_teamId")
  reactivationEntryTeam      ReactivationEntry[]      @relation("ReactivationEntry_teamId")
  crmEventTeam               CrmEvent[]               @relation("CrmEvent_teamId")
  importJobTeam              ImportJob[]              @relation("ImportJob_teamId")
  targetTeam                 Target[]                 @relation("Target_teamId")
  dealTeam                   Deal[]                   @relation("Deal_teamId")
  paymentTeam                Payment[]                @relation("Payment_teamId")
  refundTeam                 Refund[]                 @relation("Refund_teamId")
  feedbackEntryTeam          FeedbackEntry[]          @relation("FeedbackEntry_teamId")
  growthOpportunityTeam      GrowthOpportunity[]      @relation("GrowthOpportunity_teamId")
  requisitionTeam            Requisition[]            @relation("Requisition_teamId")
  complaintTeam              Complaint[]              @relation("Complaint_teamId")
  relationshipEscalationTeam RelationshipEscalation[] @relation("RelationshipEscalation_teamId")
  handoverRecordTeam         HandoverRecord[]         @relation("HandoverRecord_teamId")
  xfTaskTeam                 XfTask[]                 @relation("XfTask_teamId")
  actionItemTeam             ActionItem[]             @relation("ActionItem_teamId")

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMembership {
  id             String         @id @default(uuid()) @db.Uuid
  teamId         String         @map("team_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  membershipRole MembershipRole @default(MEMBER) @map("membership_role")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_memberships")
}

/// Explicit, time-boxed delegation: delegate sees the delegator's team scope.
model Delegation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  delegatorId    String    @map("delegator_id") @db.Uuid
  delegateId     String    @map("delegate_id") @db.Uuid
  createdById    String    @map("created_by_id") @db.Uuid
  startsAt       DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  delegator    User         @relation("DelegationDelegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegate     User         @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DelegationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, delegateId])
  @@map("delegations")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// sha256 of the opaque cookie token; the raw token is never stored.
  tokenHash         String    @unique @map("token_hash")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt         DateTime  @default(now()) @map("rotated_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?   @map("revoked_reason")
  rotatedFromId     String?   @map("rotated_from_id") @db.Uuid
  /// Stable across rotations; CSRF token is derived from it.
  familyId          String    @map("family_id") @db.Uuid
  ip                String?
  userAgent         String?   @map("user_agent")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Password-reset and invite tokens: hashed, single-use, expiring.
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("password_reset_tokens")
}

/// "I forgot my password": there is no e-mail, so the request waits here until HR / the Founder / the Developer issues a one-time link.
model PasswordResetRequest {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  status         ResetRequestStatus @default(PENDING)
  requestedAt    DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  handledById    String?            @map("handled_by_id") @db.Uuid
  handledAt      DateTime?          @map("handled_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("ResetRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  handledBy    User?        @relation("ResetRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, requestedAt])
  @@index([userId, status])
  @@map("password_reset_requests")
}

/// Append-only (DB trigger blocks UPDATE/DELETE; see prisma/sql/guards.sql).
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json     @default("{}")
  ip             String?
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, actorId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

/// Developer Panel "Feature access": per-role or per-user ON/OFF for one permission key, layered over the code catalogue
/// (permissions.catalogue.ts). subjectType ROLE -> subjectKey is a role key (e.g. SALES_EXECUTIVE); USER -> a user id.
/// GRANT adds the key at `scope`; DENY removes it. No row = the catalogue default applies. Every change is audited.
model FeatureOverride {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// ROLE | USER
  subjectType    String   @map("subject_type")
  subjectKey     String   @map("subject_key")
  permissionKey  String   @map("permission_key")
  /// GRANT | DENY
  effect         String
  /// own | team | org | summary (GRANT only)
  scope          String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, subjectType, subjectKey, permissionKey])
  @@index([organizationId, subjectType, subjectKey])
  @@map("feature_overrides")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id")
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  dispatchedAt   DateTime?    @map("dispatched_at") @db.Timestamptz(6)
  lastError      String?      @map("last_error")
  /// Optional business idempotency key; duplicate publishes are ignored.
  idempotencyKey String?      @unique @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([eventType, createdAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, scope, key])
  @@map("idempotency_keys")
}
