  @@map("growth_opportunities")
}

model StrategyPlan {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  periodId       String?    @map("period_id") @db.Uuid
  title          String
  summary        String
  status         PlanStatus @default(DRAFT)
  ownerId        String     @map("owner_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  period      TargetPeriod?        @relation(fields: [periodId], references: [id], onDelete: SetNull)
  initiatives StrategyInitiative[]

  organization Organization @relation("StrategyPlan_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  owner        User         @relation("StrategyPlan_ownerId", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("strategy_plans")
}

model StrategyInitiative {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  planId         String           @map("plan_id") @db.Uuid
