// Platform domain (Phase 8/9): notifications, deliveries, consent, integrations, webhooks, files, recordings (reserved),
// AI copilot suggestions/usage, companion devices, provider call events, platform settings.
// Owned by the platform agent (Agent F). organization_id / user_id are plain UUID columns (no Prisma relation to the
// identity models to avoid touching their files); org scoping is enforced in every query. See docs/platform-report.md.

// ───────────────────────────── notifications ─────────────────────────────

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  CALENDAR
}

/// In-app notification (one row per recipient). Unique (organization_id, user_id, dedupe_key) = anti-spam.
model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  type           String
  severity       NotificationSeverity @default(INFO)
  status         NotificationStatus   @default(UNREAD)
  title          String
  body           String?
  entityType     String?              @map("entity_type")
  entityId       String?              @map("entity_id")
  /// Relative app link (e.g. /crm/leads/<id>). Always a same-origin path.
  actionUrl      String?              @map("action_url")
  dedupeKey      String               @map("dedupe_key")
  /// How many times the same dedupeKey was raised again (suppressed duplicates).
  occurrences    Int                  @default(1)
  payload        Json                 @default("{}")
  /// Quiet hours: external channels held until this time (in-app is still stored).
  quietUntil     DateTime?            @map("quiet_until") @db.Timestamptz(6)
  isDigest       Boolean              @default(false) @map("is_digest")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lastRaisedAt   DateTime             @default(now()) @map("last_raised_at") @db.Timestamptz(6)
  readAt         DateTime?            @map("read_at") @db.Timestamptz(6)
  dismissedAt    DateTime?            @map("dismissed_at") @db.Timestamptz(6)

  deliveries NotificationDelivery[]

  organization Organization @relation("Notification_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("Notification_userId", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, dedupeKey])
  @@index([organizationId, userId, status, createdAt(sort: Desc)])
  @@index([organizationId, userId, type, createdAt])
  @@map("notifications")
}

/// Per user / type / channel opt in or out. type '*' = all types.
model NotificationPreference {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  type           String              @default("*")
  channel        NotificationChannel
  enabled        Boolean
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("NotificationPreference_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("NotificationPreference_userId", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type, channel])
  @@index([organizationId, userId])
  @@map("notification_preferences")
}

/// Per user quiet hours / working hours override (null = use organisation config).
model NotificationUserSettings {
  userId         String   @id @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// "HH:mm" local to timezone
  quietStart     String?  @map("quiet_start")
  quietEnd       String?  @map("quiet_end")
  timezone       String?
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation("NotificationUserSettings_userId", fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation("NotificationUserSettings_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("notification_user_settings")
}

/// Organisation notification config: working hours, quiet hours, digest thresholds.
model NotificationOrgConfig {
  organizationId      String   @id @map("organization_id") @db.Uuid
  quietStart          String   @default("21:00") @map("quiet_start")
  quietEnd            String   @default("08:00") @map("quiet_end")
  timezone            String   @default("Asia/Kolkata")
  /// ISO weekdays 1..7 (Mon=1) considered working days
  workingDays         Int[]    @default([1, 2, 3, 4, 5, 6]) @map("working_days")
  /// This many un-read notifications of one type inside the window collapse into a digest.
  digestThreshold     Int      @default(5) @map("digest_threshold")
  digestWindowMinutes Int      @default(60) @map("digest_window_minutes")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("NotificationOrgConfig_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("notification_org_config")
}

/// Per type rule overrides (enable/disable, channels, severity). Absent = catalogue default.
model NotificationRule {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  type             String
  enabled          Boolean               @default(true)
  channels         NotificationChannel[]
  severity         NotificationSeverity?
  /// Ignore quiet hours for this type (CRITICAL always bypasses).
  bypassQuietHours Boolean               @default(false) @map("bypass_quiet_hours")
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("NotificationRule_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, type])
  @@map("notification_rules")
}

// ───────────────────────────── deliveries / consent ─────────────────────────────

enum DeliveryStatus {
  /// created, waiting for the worker
  QUEUED
  /// worker accepted by provider (NOT delivered)
  SENT
  /// ONLY via a verified provider callback
  DELIVERED
  /// provider callback or send error; may retry
  FAILED
  /// retries exhausted
  DEAD_LETTER
  /// consent missing / opted out / channel disabled
  SUPPRESSED
  CANCELLED
}

model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  notificationId    String?             @map("notification_id") @db.Uuid
  /// internal recipient (user) when applicable
  userId            String?             @map("user_id") @db.Uuid
  channel           NotificationChannel
  provider          String
  toAddress         String              @map("to_address")
  subject           String?
  body              String
  status            DeliveryStatus      @default(QUEUED)
  attempts          Int                 @default(0)
  maxAttempts       Int                 @default(5) @map("max_attempts")
  nextAttemptAt     DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastAttemptAt     DateTime?           @map("last_attempt_at") @db.Timestamptz(6)
  providerReference String?             @map("provider_reference")
  errorCode         String?             @map("error_code")
  errorMessage      String?             @map("error_message")
  idempotencyKey    String              @map("idempotency_key")
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification Notification?               @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  events       NotificationDeliveryEvent[]

  organization Organization @relation("NotificationDelivery_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation("NotificationDelivery_userId", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, nextAttemptAt])
  @@index([provider, providerReference])
  @@map("notification_deliveries")
}

/// Append-only transition history of a delivery (status machine evidence).
model NotificationDeliveryEvent {
  id         String          @id @default(uuid()) @db.Uuid
  deliveryId String          @map("delivery_id") @db.Uuid
  fromStatus DeliveryStatus? @map("from_status")
  toStatus   DeliveryStatus  @map("to_status")
  /// WORKER | PROVIDER_CALLBACK | ADMIN | SYSTEM
  source     String
  detail     Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@map("notification_delivery_events")
}

enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
}

/// Consent / opt-out per channel and recipient address (lead/contact phone or email) or internal user.
model ConsentRecord {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  channel        NotificationChannel
  /// normalised e-mail (lower-case) or E.164 phone
  address        String
  subjectType    String?             @map("subject_type")
  subjectId      String?             @map("subject_id")
  status         ConsentStatus
  source         String
  recordedById   String?             @map("recorded_by_id") @db.Uuid
  recordedAt     DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(6)

  organization Organization @relation("ConsentRecord_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("ConsentRecord_recordedById", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, channel, address])
  @@map("consent_records")
}

// ───────────────────────────── integrations / webhooks ─────────────────────────────

enum IntegrationKind {
  EMAIL
  WHATSAPP
  SMS
  CALENDAR
  TELEPHONY
}

enum IntegrationMode {
  SANDBOX
  LIVE
}

model IntegrationConfig {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  provider            String
  kind                IntegrationKind
  enabled             Boolean         @default(false)
  mode                IntegrationMode @default(SANDBOX)
  /// Non-secret settings only (sender id, region...).
  settings            Json            @default("{}")
  /// AES-256-GCM envelope "v1:<iv>:<tag>:<ciphertext>" (base64). NEVER returned by the API.
  secretCipher        String?         @map("secret_cipher")
  webhookSecretCipher String?         @map("webhook_secret_cipher")
  keyVersion          Int             @default(1) @map("key_version")
  /// Non-null when real credentials are not available/approved (DEC-013).
  blockedReason       String?         @map("blocked_reason")
  lastHealthAt        DateTime?       @map("last_health_at") @db.Timestamptz(6)
  lastHealthStatus    String?         @map("last_health_status")
  lastError           String?         @map("last_error")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("IntegrationConfig_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, provider])
  @@map("integration_configs")
}

/// Replay protection + audit of inbound provider webhooks. Unique (provider, event_id).
model WebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  provider       String
  eventId        String   @map("event_id")
  payloadHash    String   @map("payload_hash")
  /// ACCEPTED | IGNORED | FAILED
  outcome        String
  detail         String?
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  organization Organization? @relation("WebhookEvent_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

/// Provider-verified call events (source = PROVIDER). Consumed by the CRM through CallEventPort / outbox.
model ProviderCallEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  provider       String
  providerCallId String    @map("provider_call_id")
  direction      String
  /// internal user the provider attributes the call to (agent), if resolvable
  userId         String?   @map("user_id") @db.Uuid
  fromNumber     String?   @map("from_number")
  toNumber       String?   @map("to_number")
  status         String
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  durationSec    Int?      @map("duration_sec")
  /// Always PROVIDER (kept as a column so KPI queries can filter explicitly)
  source         String    @default("PROVIDER")
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  organization Organization @relation("ProviderCallEvent_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation("ProviderCallEvent_userId", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, provider, providerCallId])
  @@map("provider_call_events")
}

// ───────────────────────────── files ─────────────────────────────

enum FileStatus {
  PENDING
  SCANNING
  PROCESSING
  READY
  REJECTED
  FAILED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  /// scanner unavailable or disabled: the UI must say "not scanned"
  NOT_SCANNED
  ERROR
}

model FileAsset {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  uploaderId     String     @map("uploader_id") @db.Uuid
  category       String
  /// sanitised display name only; never used in the storage key
  displayName    String     @map("display_name")
  extension      String
  contentType    String     @map("content_type")
  declaredType   String?    @map("declared_type")
  sizeBytes      BigInt     @map("size_bytes")
  sha256         String
  bucket         String
  storageKey     String     @unique @map("storage_key")
  /// processed derivative (WebP / optimised PDF) key; original is always kept
  derivedKey     String?    @map("derived_key")
  derivedType    String?    @map("derived_type")
  derivedSize    BigInt?    @map("derived_size")
  status         FileStatus @default(PENDING)
  progress       Int        @default(0)
  scanStatus     ScanStatus @default(PENDING) @map("scan_status")
  scanDetail     String?    @map("scan_detail")
  /// honest processing outcome text (e.g. "pdf: stored original, no optimiser installed")
  processingNote String?    @map("processing_note")
  attempts       Int        @default(0)
  lastError      String?    @map("last_error")
  width          Int?
  height         Int?
  retentionUntil DateTime?  @map("retention_until") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedById    String?    @map("deleted_by_id") @db.Uuid
  purgedAt       DateTime?  @map("purged_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  attachments FileAttachment[]

  organization Organization @relation("FileAsset_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  uploader     User         @relation("FileAsset_uploaderId", fields: [uploaderId], references: [id], onDelete: Restrict)
  deletedBy    User?        @relation("FileAsset_deletedById", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([organizationId, uploaderId, createdAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([deletedAt, retentionUntil])
  @@map("file_assets")
}

/// A file inherits the access scope of every entity it is attached to (see FileAccessRegistry).
model FileAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fileId         String   @map("file_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  attachedById   String   @map("attached_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  organization Organization @relation("FileAttachment_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  attachedBy   User         @relation("FileAttachment_attachedById", fields: [attachedById], references: [id], onDelete: Restrict)

  @@unique([fileId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@map("file_attachments")
}

enum RecordingConsentStatus {
  NONE
  REQUESTED
  GRANTED
  REVOKED
}

/// RESERVED (DEC-014, BP-AND-008): call recording is BLOCKED pending technical/consent/privacy/legal review.
/// Schema only; endpoints are guarded by feature flag `recordings.enabled` (default false, no code path sets it).
model RecordingAsset {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  callLogId         String?                @map("call_log_id") @db.Uuid
  fileId            String?                @map("file_id") @db.Uuid
  consentStatus     RecordingConsentStatus @default(NONE) @map("consent_status")
  consentRecordedAt DateTime?              @map("consent_recorded_at") @db.Timestamptz(6)
  legalReviewRef    String?                @map("legal_review_ref")
  retentionUntil    DateTime?              @map("retention_until") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation("RecordingAsset_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, callLogId])
  @@map("recording_assets")
}

// ───────────────────────────── AI copilot ─────────────────────────────

enum AiSuggestionStatus {
  DRAFT
  ACCEPTED
  EDITED
  REJECTED
}

model AiSuggestion {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  /// summarize | extract | draft_followup | call_brief | lead_priority
  feature          String
  entityType       String?            @map("entity_type")
  entityId         String?            @map("entity_id")
  status           AiSuggestionStatus @default(DRAFT)
  /// Validated output (see AI output schemas). Labelled as AI suggestion.
  output           Json
  editedOutput     Json?              @map("edited_output")
  /// What data / time period the suggestion is based on.
  sources          Json               @default("{}")
  provider         String
  model            String
  insufficientData Boolean            @default(false) @map("insufficient_data")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt       DateTime?          @map("reviewed_at") @db.Timestamptz(6)

  organization Organization @relation("AiSuggestion_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("AiSuggestion_userId", fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@map("ai_suggestions")
}

model AiUsageLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  feature        String
  provider       String
  model          String
  /// OK | FAILED | BLOCKED | INSUFFICIENT_DATA | RATE_LIMITED | INVALID_OUTPUT
  outcome        String
  latencyMs      Int      @default(0) @map("latency_ms")
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  costUsd        Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  errorCode      String?  @map("error_code")
  redactions     Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation("AiUsageLog_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("AiUsageLog_userId", fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, userId, createdAt])
  @@map("ai_usage_logs")
}

// ───────────────────────────── devices / settings ─────────────────────────────

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

/// Approved companion devices (data model only; Android go/no-go is NO-GO for v1, DEC-036).
model Device {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  platform             String       @default("ANDROID")
  label                String
  /// SHA-256 of the client supplied device identifier (raw id never stored)
  deviceIdHash         String       @map("device_id_hash")
  osVersion            String?      @map("os_version")
  appVersion           String?      @map("app_version")
  /// Version of the on-device disclosure text the user accepted
  disclosureVersion    String       @map("disclosure_version")
  disclosureAcceptedAt DateTime     @map("disclosure_accepted_at") @db.Timestamptz(6)
  status               DeviceStatus @default(PENDING)
  approvedById         String?      @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?    @map("approved_at") @db.Timestamptz(6)
  revokedById          String?      @map("revoked_by_id") @db.Uuid
  revokedAt            DateTime?    @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt           DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation("Device_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("Device_userId", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("Device_approvedById", fields: [approvedById], references: [id], onDelete: Restrict)
  revokedBy    User?        @relation("Device_revokedById", fields: [revokedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, deviceIdHash])
  @@index([organizationId, status])
  @@map("devices")
}

/// Key/value platform settings per organisation: files limits, ai config, feature flags (devices.enabled, recordings.enabled).
model PlatformSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  value          Json
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("PlatformSetting_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    User?        @relation("PlatformSetting_updatedById", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("platform_settings")
}
