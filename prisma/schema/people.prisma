  DOCUMENT
  TEMPLATE
  LINK
  COURSE
}

enum ResourceAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

model Resource {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String
  description    String?
  type           ResourceType @default(ARTICLE)
  url            String?
  /**
   * FileRef placeholder.
   */
  fileId         String?      @map("file_id") @db.Uuid
  skillTags      String[]     @default([]) @map("skill_tags")
  isActive       Boolean      @default(true) @map("is_active")
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments ResourceAssignment[]

  organization Organization @relation("Resource_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("Resource_createdById", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, isActive])
  @@map("resources")
}

model ResourceAssignment {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  resourceId     String                   @map("resource_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  assignedById   String                   @map("assigned_by_id") @db.Uuid
  dueDate        DateTime?                @map("due_date") @db.Date
  status         ResourceAssignmentStatus @default(ASSIGNED)
  completedAt    DateTime?                @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  organization Organization @relation("ResourceAssignment_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("ResourceAssignment_userId", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User         @relation("ResourceAssignment_assignedById", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([resourceId, userId])
  @@index([organizationId, userId, status])
  @@map("resource_assignments")
}
