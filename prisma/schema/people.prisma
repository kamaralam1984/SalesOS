// people + sop domain models (Phase 6). Owned by the people agent.
// Conventions: UUID PKs, organization_id scope, TIMESTAMPTZ, Decimal money + currency, @@map snake_case.
// User / organization references are plain UUID columns (no @relation) so this domain never edits the identity
// models; tenant and user-membership checks are enforced in services (see docs/people-report.md, "Reconcile").
// FileRef: `fileId` / `*FileIds` columns store ids only; the file service (Agent F) owns the bytes.

// ---------------------------------------------------------------- SOP centre

enum SopCategory {
  LEAD_HANDLING
  FOLLOW_UP_CADENCE
  WEBINAR_DEMO
  OBJECTION_HANDLING
  CLOSING_NEGOTIATION
  PAYMENT
  HANDOVER_STUDENT_SUCCESS
  CALL_SCRIPT
  WHATSAPP_TEMPLATE
  CRM_USAGE
  REPORTING_FORMAT
  OTHER
}

enum SopDocumentStatus {
  ACTIVE
  RETIRED
}

/// DRAFT -> PENDING_APPROVAL -> APPROVED (immutable) -> SUPERSEDED | RETIRED ; PENDING_APPROVAL -> REJECTED | DRAFT
enum SopVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
  RETIRED
}

enum ProcessGapStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum ProcessGapKind {
  PROCESS_GAP
  AUTOMATION
}

model SopDocument {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  category       SopCategory
  title          String
  summary        String?
  ownerId        String            @map("owner_id") @db.Uuid
  isMandatory    Boolean           @default(true) @map("is_mandatory")
  /**
   * Role keys that must acknowledge the effective version (empty = every active user).
   */
  audienceRoles  String[]          @default([]) @map("audience_roles")
  tags           String[]          @default([])
  status         SopDocumentStatus @default(ACTIVE)
  createdById    String            @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions SopVersion[]

  organization Organization @relation("SopDocument_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  owner        User         @relation("SopDocument_ownerId", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("SopDocument_createdById", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, category])
  @@index([organizationId, status])
  @@map("sop_documents")
}

model SopVersion {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  documentId        String           @map("document_id") @db.Uuid
  versionNumber     Int              @map("version_number")
  title             String
  body              String
  changeSummary     String?          @map("change_summary")
  effectiveDate     DateTime?        @map("effective_date") @db.Date
  status            SopVersionStatus @default(DRAFT)
  /**
   * FileRef placeholders: ids owned by the file service.
   */
  attachmentFileIds String[]         @default([]) @map("attachment_file_ids")
  createdById       String           @map("created_by_id") @db.Uuid
  submittedAt       DateTime?        @map("submitted_at") @db.Timestamptz(6)
  approvedById      String?          @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz(6)
  rejectedById      String?          @map("rejected_by_id") @db.Uuid
  rejectionReason   String?          @map("rejection_reason")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  document         SopDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  acknowledgements SopAcknowledgement[]

  organization Organization @relation("SopVersion_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("SopVersion_createdById", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("SopVersion_approvedById", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy   User?        @relation("SopVersion_rejectedById", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([organizationId, status])
  @@index([documentId, status])
  @@map("sop_versions")
}

model SopAcknowledgement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at") @db.Timestamptz(6)

  version SopVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  organization Organization @relation("SopAcknowledgement_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("SopAcknowledgement_userId", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([versionId, userId])
  @@index([organizationId, userId])
  @@index([documentId, userId])
  @@map("sop_acknowledgements")
}

model ProcessGap {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  kind           ProcessGapKind   @default(PROCESS_GAP)
  title          String
  description    String?
  ownerId        String?          @map("owner_id") @db.Uuid
  status         ProcessGapStatus @default(OPEN)
  priority       Int              @default(3)
  resolution     String?
  linkedSopId    String?          @map("linked_sop_id") @db.Uuid
  reportedById   String           @map("reported_by_id") @db.Uuid
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("ProcessGap_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  owner        User?        @relation("ProcessGap_ownerId", fields: [ownerId], references: [id], onDelete: Restrict)
  reportedBy   User         @relation("ProcessGap_reportedById", fields: [reportedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("process_gaps")
}

// ---------------------------------------------------------------- shared state log

/// Append-style history for state machines (PIP, incentive, review). Rows are never updated.
model PeopleStateLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  fromStatus     String?  @map("from_status")
  toStatus       String   @map("to_status")
  actorId        String?  @map("actor_id") @db.Uuid
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation("PeopleStateLog_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("PeopleStateLog_actorId", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@map("people_state_log")
}

// ---------------------------------------------------------------- coaching

enum CoachingTopic {
  CALL_QUALITY
  OBJECTION_HANDLING
  CONSULTATIVE_SELLING
  CLOSING
  NEGOTIATION
  PIPELINE_MANAGEMENT
  FORECASTING
  CRM_USAGE
  LEADERSHIP
  OTHER
}

enum CoachingKind {
  COACHING
  SCORECARD_REVIEW
  CALL_REVIEW
  ROLE_PLAY
}

/// Who may read the free-text notes of a session.
enum NoteVisibility {
  COACH_ONLY
  PARTICIPANTS
  MANAGEMENT
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum OneOnOneStatus {
  SCHEDULED
  HELD
  CANCELLED
}

model CoachingSession {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  coachId        String          @map("coach_id") @db.Uuid
  kind           CoachingKind    @default(COACHING)
  sessionDate    DateTime        @map("session_date") @db.Timestamptz(6)
  durationMin    Int             @map("duration_min")
  topics         CoachingTopic[]
  notes          String?
  noteVisibility NoteVisibility  @default(PARTICIPANTS) @map("note_visibility")
  /**
   * Optional reference to a call record (CRM phase) - id only.
   */
  callRef        String?         @map("call_ref")
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  participants CoachingParticipant[]
  actions      CoachingAction[]

  organization Organization @relation("CoachingSession_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  coach        User         @relation("CoachingSession_coachId", fields: [coachId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("CoachingSession_createdById", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, sessionDate])
  @@index([organizationId, coachId])
  @@map("coaching_sessions")
}

model CoachingParticipant {
  id             String @id @default(uuid()) @db.Uuid
  sessionId      String @map("session_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  session CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  user         User         @relation("CoachingParticipant_userId", fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation("CoachingParticipant_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([sessionId, userId])
  @@index([organizationId, userId])
  @@map("coaching_participants")
}

model OneOnOne {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  managerId      String         @map("manager_id") @db.Uuid
  employeeId     String         @map("employee_id") @db.Uuid
  status         OneOnOneStatus @default(HELD)
  scheduledFor   DateTime       @map("scheduled_for") @db.Timestamptz(6)
  durationMin    Int            @default(30) @map("duration_min")
  agenda         String?
  /**
   * Visible to the employee and the manager.
   */
  sharedNotes    String?        @map("shared_notes")
  /**
   * Manager-only notes (never returned to the employee).
   */
  privateNotes   String?        @map("private_notes")
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  actions CoachingAction[]

  organization Organization @relation("OneOnOne_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  manager      User         @relation("OneOnOne_managerId", fields: [managerId], references: [id], onDelete: Restrict)
  employee     User         @relation("OneOnOne_employeeId", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("OneOnOne_createdById", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, scheduledFor])
  @@index([organizationId, managerId])
  @@map("one_on_ones")
}

model CoachingAction {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  sessionId      String?      @map("session_id") @db.Uuid
  oneOnOneId     String?      @map("one_on_one_id") @db.Uuid
  /**
   * Free source reference for actions raised from reviews/PIPs: `review:<id>` etc.
   */
  sourceRef      String?      @map("source_ref")
  ownerId        String       @map("owner_id") @db.Uuid
  title          String
  dueDate        DateTime?    @map("due_date") @db.Date
  status         ActionStatus @default(OPEN)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  session  CoachingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  oneOnOne OneOnOne?        @relation(fields: [oneOnOneId], references: [id], onDelete: Cascade)

  organization Organization @relation("CoachingAction_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  owner        User         @relation("CoachingAction_ownerId", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("CoachingAction_createdById", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, ownerId, status])
  @@map("coaching_actions")
}

// ---------------------------------------------------------------- KPI/KRA, scorecards, reviews

enum KpiKind {
  KPI
  KRA
}

enum PeriodType {
  WEEK
  MONTH
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACKNOWLEDGED
}

model KpiDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  kind           KpiKind  @default(KPI)
  description    String?
  unit           String?
  /**
   * Key in docs/kpi-dictionary.md (Phase 5 computes the value; Phase 6 only references it).
   */
  dictionaryKey  String?  @map("dictionary_key")
  roleKeys       String[] @default([]) @map("role_keys")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("KpiDefinition_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("kpi_definitions")
}

model KpiAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  assigneeId     String   @map("assignee_id") @db.Uuid
  /**
   * Monday (UTC date) of the assigned week.
   */
  weekStart      DateTime @map("week_start") @db.Date
  /**
   * [{ definitionId?, key, name, kind, target?, unit?, notes? }]
   */
  items          Json     @default("[]")
  setById        String   @map("set_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("KpiAssignment_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  assignee     User         @relation("KpiAssignment_assigneeId", fields: [assigneeId], references: [id], onDelete: Restrict)
  setBy        User         @relation("KpiAssignment_setById", fields: [setById], references: [id], onDelete: Restrict)

  @@unique([assigneeId, weekStart])
  @@index([organizationId, weekStart])
  @@map("kpi_assignments")
}

/// Stores scorecard INPUTS (targets, manual entries, references to Phase 5 KPI keys). Computed values come from Phase 5.
model Scorecard {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  subjectId      String     @map("subject_id") @db.Uuid
  periodType     PeriodType @default(WEEK) @map("period_type")
  periodStart    DateTime   @map("period_start") @db.Date
  periodEnd      DateTime   @map("period_end") @db.Date
  /**
   * [{ key, name, target?, actual?, unit?, source: 'MANUAL' | 'PHASE5' }]
   */
  inputs         Json       @default("[]")
  comments       String?
  createdById    String     @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("Scorecard_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  subject      User         @relation("Scorecard_subjectId", fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("Scorecard_createdById", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([subjectId, periodType, periodStart])
  @@index([organizationId, periodStart])
  @@map("scorecards")
}

/// Competency framework (JD key competencies). Used in reviews, probation and interviews.
model ReviewRubric {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  /**
   * Behavioural indicators by level: { "1": "...", "3": "...", "5": "..." }
   */
  indicators     Json     @default("{}")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation("ReviewRubric_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("review_rubrics")
}

model PerformanceReview {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  employeeId       String       @map("employee_id") @db.Uuid
  reviewerId       String       @map("reviewer_id") @db.Uuid
  periodType       PeriodType   @default(MONTH) @map("period_type")
  periodStart      DateTime     @map("period_start") @db.Date
  periodEnd        DateTime     @map("period_end") @db.Date
  status           ReviewStatus @default(DRAFT)
  /**
   * KPI inputs/outcomes summarised by the reviewer (references, not computed values).
   */
  kpiSummary       Json         @default("[]") @map("kpi_summary")
  /**
   * { competencyKey: 1..5 }
   */
  competencyScores Json         @default("{}") @map("competency_scores")
  rating           Int?
  strengths        String?
  improvements     String?
  goals            String?
  employeeComment  String?      @map("employee_comment")
  approvedById     String?      @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?    @map("approved_at") @db.Timestamptz(6)
  acknowledgedAt   DateTime?    @map("acknowledged_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("PerformanceReview_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  employee     User         @relation("PerformanceReview_employeeId", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer     User         @relation("PerformanceReview_reviewerId", fields: [reviewerId], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("PerformanceReview_approvedById", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([employeeId, periodType, periodStart])
  @@index([organizationId, periodStart])
  @@map("performance_reviews")
}

// ---------------------------------------------------------------- PIP

enum PipStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXTENDED
  COMPLETED_SUCCESS
  COMPLETED_NOT_IMPROVED
  CANCELLED
}

enum CheckpointStatus {
  PENDING
  DONE
  MISSED
}

model ImprovementPlan {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  employeeId             String    @map("employee_id") @db.Uuid
  createdById            String    @map("created_by_id") @db.Uuid
  /// created by a Sales Manager through pip:propose; stays DRAFT until the Team Lead / HR takes it forward
  proposedByManager      Boolean   @default(false) @map("proposed_by_manager")
  status                 PipStatus @default(DRAFT)
  reason                 String
  kpiGaps                Json      @default("[]") @map("kpi_gaps")
  evidence               String?
  goals                  Json      @default("[]")
  measures               Json      @default("[]")
  durationDays           Int       @default(30) @map("duration_days")
  startDate              DateTime? @map("start_date") @db.Date
  endDate                DateTime? @map("end_date") @db.Date
  extensionCount         Int       @default(0) @map("extension_count")
  extensionReason        String?   @map("extension_reason")
  /**
   * End date proposed by the Team Lead while status = EXTENDED (awaiting approver).
   */
  proposedEndDate        DateTime? @map("proposed_end_date") @db.Date
  approvedById           String?   @map("approved_by_id") @db.Uuid
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(6)
  employeeAcknowledgedAt DateTime? @map("employee_acknowledged_at") @db.Timestamptz(6)
  finalReview            String?   @map("final_review")
  recommendedAction      String?   @map("recommended_action")
  cancelReason           String?   @map("cancel_reason")
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkpoints PipCheckpoint[]

  organization Organization @relation("ImprovementPlan_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  employee     User         @relation("ImprovementPlan_employeeId", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("ImprovementPlan_createdById", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("ImprovementPlan_approvedById", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
  @@map("improvement_plans")
}

model PipCheckpoint {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  pipId          String           @map("pip_id") @db.Uuid
  dueDate        DateTime         @map("due_date") @db.Date
  title          String
  status         CheckpointStatus @default(PENDING)
  notes          String?
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  pip ImprovementPlan @relation(fields: [pipId], references: [id], onDelete: Cascade)

  organization Organization @relation("PipCheckpoint_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([pipId, dueDate])
  @@map("pip_checkpoints")
}

// ---------------------------------------------------------------- recognition

enum RecognitionKind {
  TOP_PERFORMER
  CULTURE
  MILESTONE
  AWARD
}

model RecognitionProgram {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  kind           RecognitionKind @default(AWARD)
  /**
   * Criteria text only; winner selection is a human decision.
   */
  criteria       String?
  isActive       Boolean         @default(true) @map("is_active")
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  recognitions Recognition[]

  organization Organization @relation("RecognitionProgram_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("RecognitionProgram_createdById", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("recognition_programs")
}

model Recognition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  recipientId    String   @map("recipient_id") @db.Uuid
  grantedById    String   @map("granted_by_id") @db.Uuid
  reason         String
  periodLabel    String?  @map("period_label")
  competencyKey  String?  @map("competency_key")
  /**
   * Shown on the org-wide recognition wall (minimum-data projection).
   */
  isPublic       Boolean  @default(false) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  program RecognitionProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  organization Organization @relation("Recognition_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
