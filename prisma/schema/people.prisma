  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("EmployeeProfile_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation("EmployeeProfile_userId", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeCode])
  @@index([organizationId, exitDate])
  @@map("employee_profiles")
}

