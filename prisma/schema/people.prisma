/// HR-restricted employee data (hr:records:*). Payroll, leave and attendance live in workforce.prisma (DEC-048 supersedes DEC-023).
model EmployeeProfile {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  employmentType   String    @default("FULL_TIME") @map("employment_type")
  positionTitle    String?   @map("position_title")
  joinDate         DateTime? @map("join_date") @db.Date
  probationEndDate DateTime? @map("probation_end_date") @db.Date
