// ---------------------------------------------------------------- incentives

enum IncentivePolicyStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum IncentiveStatus {
  CALCULATED
  SUBMITTED
  APPROVED
  REJECTED
  ON_HOLD
  PAID
  CLAWBACK_PROPOSED
  ADJUSTED
  WAIVED
}

enum AdjustmentStatus {
  PROPOSED
  APPLIED
  WAIVED
}

model IncentivePolicy {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  versionNumber  Int                   @map("version_number")
  name           String
  status         IncentivePolicyStatus @default(DRAFT)
  /**
   * Validated structure: basis, periodType, slabs, gates, cap, clawbackWindowDays, currency. No seeded amounts.
   */
  structure      Json
  effectiveFrom  DateTime?             @map("effective_from") @db.Date
  notes          String?
  createdById    String                @map("created_by_id") @db.Uuid
  approvedById   String?               @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?             @map("approved_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  recommendations IncentiveRecommendation[]

  organization Organization @relation("IncentivePolicy_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("IncentivePolicy_createdById", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("IncentivePolicy_approvedById", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, versionNumber])
  @@index([organizationId, status])
  @@map("incentive_policies")
}

model IncentiveRecommendation {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  policyId         String          @map("policy_id") @db.Uuid
  employeeId       String          @map("employee_id") @db.Uuid
  periodStart      DateTime        @map("period_start") @db.Date
  periodEnd        DateTime        @map("period_end") @db.Date
  status           IncentiveStatus @default(CALCULATED)
  snapshotVersion  Int             @default(1) @map("snapshot_version")
  /**
   * Immutable inputs snapshot (caller-supplied or provider-supplied) for this calculation.
   */
  inputs           Json
  inputSource      String          @default("MANUAL") @map("input_source")
  breakdown        Json
  computedAmount   Decimal         @map("computed_amount") @db.Decimal(14, 2)
  currency         String          @default("INR") @db.Char(3)
  approvedAmount   Decimal?        @map("approved_amount") @db.Decimal(14, 2)
  overrideReason   String?         @map("override_reason")
  recommendedById  String          @map("recommended_by_id") @db.Uuid
  submitComments   String?         @map("submit_comments")
  submittedAt      DateTime?       @map("submitted_at") @db.Timestamptz(6)
  decidedById      String?         @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?       @map("decided_at") @db.Timestamptz(6)
  rejectionReason  String?         @map("rejection_reason")
  holdReason       String?         @map("hold_reason")
  paidAt           DateTime?       @map("paid_at") @db.Timestamptz(6)
  paidById         String?         @map("paid_by_id") @db.Uuid
  paymentReference String?         @map("payment_reference")
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  policy      IncentivePolicy       @relation(fields: [policyId], references: [id], onDelete: Restrict)
  adjustments IncentiveAdjustment[]

  organization  Organization @relation("IncentiveRecommendation_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  employee      User         @relation("IncentiveRecommendation_employeeId", fields: [employeeId], references: [id], onDelete: Restrict)
  recommendedBy User         @relation("IncentiveRecommendation_recommendedById", fields: [recommendedById], references: [id], onDelete: Restrict)
  decidedBy     User?        @relation("IncentiveRecommendation_decidedById", fields: [decidedById], references: [id], onDelete: Restrict)
  paidBy        User?        @relation("IncentiveRecommendation_paidById", fields: [paidById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, employeeId, periodStart])
  @@map("incentive_recommendations")
}

/// Clawback proposals created from refund events (never applied automatically).
model IncentiveAdjustment {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  recommendationId   String           @map("recommendation_id") @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  refundId           String           @map("refund_id") @db.Uuid
  /**
   * Proposed negative adjustment amount (positive number = amount to claw back).
   */
  proposedAmount     Decimal          @map("proposed_amount") @db.Decimal(14, 2)
  decidedAmount      Decimal?         @map("decided_amount") @db.Decimal(14, 2)
  currency           String           @default("INR") @db.Char(3)
  status             AdjustmentStatus @default(PROPOSED)
  reason             String?
  decidedById        String?          @map("decided_by_id") @db.Uuid
  decidedAt          DateTime?        @map("decided_at") @db.Timestamptz(6)
  appliedPeriodStart DateTime?        @map("applied_period_start") @db.Date
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  recommendation IncentiveRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  organization Organization @relation("IncentiveAdjustment_organizationId", fields: [organizationId], references: [id], onDelete: Restrict)
  employee     User         @relation("IncentiveAdjustment_employeeId", fields: [employeeId], references: [id], onDelete: Restrict)
  decidedBy    User?        @relation("IncentiveAdjustment_decidedById", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([recommendationId, refundId])
  @@index([organizationId, status])
  @@map("incentive_adjustments")
}

